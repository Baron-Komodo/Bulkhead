      "specs": {
        "Subtype": "Large displacement unmanned underwater vehicle",
        "Displacement": "3 tons",
        "Width": "1.2 m (3.9 ft)",
        "Length": "5.8 m (19.0 ft)",
        "Max. depth": "6000 m (19685.0 ft)",
