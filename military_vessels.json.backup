      "update_log": [
        "JUL 23 2026 Updated Sources and cross-references refreshed",
        "JUL 18 2026 Updated Width, length and secondary name added; type, manufacturer and 2 more fields updated",
        "JAN 24 2026 Updated Range, top speed and 3 more fields updated",
