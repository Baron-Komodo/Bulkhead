      "update_log": [
        "AUG 8 2026 Updated Thrust updated",
        "APR 7 2026 Updated Description updated in a site-wide editorial pass",
        "JAN 24 2026 Updated Max speed updated",
        "JAN 18 2026 Updated Type, manufacturer and 5 more fields updated"
