      "url": "https://www.globalmilitary.net/ships/dive-ld/",
      "slug": "dive-ld",
      "page_title": "Dive-LD (LDUUV) Unmanned vessel: Full Specs & Armament",
      "meta_description": "Dive-LD unmanned vessel specs: displacement, dimensions, armament, propulsion and speed. United States naval vessel commissioned in 2024 — full specifications, history and operators.",
      "canonical": "https://www.globalmilitary.net/ships/dive-ld/",
      "type": "Unmanned vessel",
      "manufacturer": "Anduril Industries",
      "category_url": "https://www.globalmilitary.net/ships/category/unmanned/",
      "ship_name": "Dive-LD (LDUUV)",
      "summary": "Anduril Industries' large displacement unmanned underwater vehicle, in US Navy service since 2024, built for mine countermeasures and seabed mapping with a 3D-printed hull rated to 6,000 meters. Key figures: displacement 3 tons, length 5.8 m. No longer in service; operated by 1 navy over its career.",
      "origin_text": "🇺🇸 United States",
      "commissioned": "2024",
      "updated": "12 Sep 2026",
      "displacement": "3 tons",
      "origin": "United States",
      "origin_code": "usa",
